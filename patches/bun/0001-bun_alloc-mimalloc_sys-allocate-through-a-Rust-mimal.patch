+//! wasm-experiment: the `libc` items this crate names, for `target_family = "wasm"` where the
+//! `libc` crate has none. Mounted as `crate::libc`; the allocation functions are the mimalloc shim.
+
+use core::ffi::{c_char, c_void};
+
+#[repr(C, align(16))]
+pub(crate) struct max_align_t([u8; 16]);
+
+pub(crate) unsafe fn malloc(size: usize) -> *mut c_void {
+    crate::mimalloc::mi_malloc(size)
+}
+
+pub(crate) unsafe fn realloc(p: *mut c_void, size: usize) -> *mut c_void {
+    unsafe { crate::mimalloc::mi_realloc(p, size) }
+}
+
+pub(crate) unsafe fn free(p: *mut c_void) {
+    unsafe { crate::mimalloc::mi_free(p) }
+}
+
+pub(crate) unsafe fn strlen(s: *const c_char) -> usize {
+    unsafe { core::ffi::CStr::from_ptr(s).count_bytes() }
+}
