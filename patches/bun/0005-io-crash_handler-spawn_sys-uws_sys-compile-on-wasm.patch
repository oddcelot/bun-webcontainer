 src/crash_handler/lib.rs         | 57 ++++++++++++++++++++-----------
 src/io/PipeReader.rs             |  4 +--
 src/io/PipeWriter.rs             | 10 +++---
 src/io/lib.rs                    | 58 +++++++++++++++++++++++++++++---
 src/io/openForWriting.rs         |  4 +--
 src/io/posix_event_loop.rs       |  9 +++--
 src/spawn_sys/spawn_process.rs   |  7 ++--
 src/uws_sys/Loop.rs              |  2 +-
 src/uws_sys/SocketContext.rs     |  5 +++
 src/uws_sys/udp.rs               |  5 ++-
 11 files changed, 135 insertions(+), 40 deletions(-)

