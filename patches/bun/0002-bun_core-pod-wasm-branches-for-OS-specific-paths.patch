     // SAFETY: zeroed sigset + SIG_DFL handler is a valid Sigaction.
     unsafe {
@@ -815,7 +827,7 @@ pub fn raise_default_action(sig: c_int) -> ! {
 }
 
 /// Exposes `raise_default_action` to C++ (`onExitSignal` in c-bindings.cpp).
-#[cfg(not(windows))]
+#[cfg(not(any(windows, target_family = "wasm")))] // wasm-experiment
 #[unsafe(no_mangle)]
