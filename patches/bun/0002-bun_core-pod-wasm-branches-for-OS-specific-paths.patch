 src/bun_core/debug.rs     |  8 +++++++-
 src/bun_core/env_var.rs   |  2 +-
 src/bun_core/lib.rs       |  4 ++--
 src/bun_core/thread_id.rs |  5 +++++
 src/bun_core/util.rs      | 42 ++++++++++++++++++++++++++++++++++-----
 src/pod/lib.rs            |  1 +
 7 files changed, 71 insertions(+), 15 deletions(-)

