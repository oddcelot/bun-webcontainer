         crate::windows_sys::kernel32::ExitProcess(code)
     }
-    #[cfg(not(any(target_os = "macos", windows)))]
+    #[cfg(not(any(target_os = "macos", windows, target_family = "wasm")))]
     {
         if env::ENABLE_ASAN {
             libc_exit(code as i32);
         }
         quick_exit(code as c_int);
     }
+    #[cfg(target_family = "wasm")] // wasm-experiment
+    {
+        let _ = code;
+        std::process::abort()
+    }
 }
 
 pub fn raise_ignoring_panic_handler(sig: crate::SignalCode) -> ! {
@@ -775,9 +781,15 @@ pub fn raise_ignoring_panic_handler_raw(sig: c_int) -> ! {
         }
     }
 
-    #[cfg(not(windows))]
+    #[cfg(not(any(windows, target_family = "wasm")))] // wasm-experiment
     raise_default_action(sig);
 
+    #[cfg(target_family = "wasm")] // wasm-experiment
+    {
+        let _ = sig;
+        std::process::abort()
+    }
+
     #[cfg(windows)]
     {
         // kill self; `raise` has no preconditions (see the `safe fn` decl above).
@@ -789,7 +801,7 @@ pub fn raise_ignoring_panic_handler_raw(sig: c_int) -> ! {
 
