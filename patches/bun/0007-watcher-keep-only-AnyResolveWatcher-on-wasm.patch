From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Kopco <hey@oddcelot.dev>
Date: Wed, 28 Oct 2026 18:28:22 +0100
Subject: [PATCH] watcher: keep only AnyResolveWatcher on wasm

---
 src/watcher/lib.rs | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/src/watcher/lib.rs b/src/watcher/lib.rs
index 5b2edfcf..7160d85b 100644
--- a/src/watcher/lib.rs
+++ b/src/watcher/lib.rs
@@ -19,21 +19,48 @@ pub mod kevent_watcher;
 #[path = "WindowsWatcher.rs"]
 pub mod windows_watcher;
 
+#[cfg(not(target_family = "wasm"))]
 #[path = "WatcherTrace.rs"]
 pub(crate) mod watcher_trace;
 
+#[cfg(not(target_family = "wasm"))]
 #[path = "Watcher.rs"]
 pub mod watcher_impl;
 
+// wasm-experiment: no threads or fs notification in the browser. Only the
+// resolver's callback type is kept so `bun_resolver` compiles.
+#[cfg(target_family = "wasm")]
+pub mod watcher_impl {
+    use bun_sys::Fd;
+
+    #[derive(Clone, Copy)]
+    pub struct AnyResolveWatcher {
+        pub(crate) context: *mut (),
+        pub(crate) callback: fn(*mut (), dir_path: &[u8], dir_fd: Fd),
+    }
+
+    impl AnyResolveWatcher {
+        #[inline]
+        pub fn watch(self, dir_path: &[u8], dir_fd: Fd) {
+            (self.callback)(self.context, dir_path, dir_fd)
+        }
+    }
+}
+
 pub mod error;
 
 // ─── public re-exports ────────────────────────────────────────────────────
 
 pub use error::{Error, Result};
 
+#[cfg(not(target_family = "wasm"))]
 pub use WatchItemKind as Kind;
+#[cfg(not(target_family = "wasm"))]
 pub use watcher_impl::{
     AnyResolveWatcher, ChangedFilePath, Event, FdOwnership, HashType, MAX_COUNT, Op, PackageJSON,
     REQUIRES_FILE_DESCRIPTORS, WATCH_OPEN_FLAGS, WATCHES_BY_PATH, WatchEvent, WatchItemColumns,
     WatchItemIndex, WatchItemKind, WatchList, Watcher, WatcherContext,
 };
+
+#[cfg(target_family = "wasm")]
+pub use watcher_impl::AnyResolveWatcher;
