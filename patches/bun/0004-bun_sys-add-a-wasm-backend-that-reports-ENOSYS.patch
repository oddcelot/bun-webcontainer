+//! wasm-experiment: the `libc` items this crate names, for `target_family = "wasm"` where the
+//! `libc` crate has none. Mounted as `crate::libc`.
+
+#![allow(non_camel_case_types)]
+
+pub(crate) use core::ffi::{c_int, c_void};
+
+pub(crate) const UTIME_NOW: i64 = (1 << 30) - 1;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct iovec {
+    pub iov_base: *mut c_void,
+    pub iov_len: usize,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct stat {
+    pub st_dev: u64,
+    pub st_ino: u64,
+    pub st_nlink: u64,
+    pub st_mode: u32,
+    pub st_uid: u32,
+    pub st_gid: u32,
+    pub st_rdev: u64,
+    pub st_size: i64,
+    pub st_blksize: i64,
+    pub st_blocks: i64,
+    pub st_atime: i64,
+    pub st_atime_nsec: i64,
+    pub st_mtime: i64,
+    pub st_mtime_nsec: i64,
+    pub st_ctime: i64,
+    pub st_ctime_nsec: i64,
+}
+
+pub(crate) const RTLD_LAZY: c_int = 1;
+pub(crate) const RTLD_LOCAL: c_int = 0;
+pub(crate) const F_GETFL: c_int = 3;
+pub(crate) const F_SETFL: c_int = 4;
+
+pub(crate) const SEEK_SET: c_int = 0;
+pub(crate) const ENAMETOOLONG: c_int = 36;
+pub(crate) const O_RDONLY: c_int = 0;
+pub(crate) const O_DIRECTORY: c_int = 0o200000;
+pub(crate) const O_CLOEXEC: c_int = 0o2000000;
+
+pub(crate) const AF_INET: c_int = 2;
+pub(crate) const AF_INET6: c_int = 10;
+pub(crate) type sa_family_t = u16;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct sockaddr {
+    pub sa_family: sa_family_t,
+    pub sa_data: [u8; 14],
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct sockaddr_in {
+    pub sin_family: sa_family_t,
+    pub sin_port: u16,
+    pub sin_addr: u32,
+    pub sin_zero: [u8; 8],
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct sockaddr_in6 {
+    pub sin6_family: sa_family_t,
+    pub sin6_port: u16,
+    pub sin6_flowinfo: u32,
+    pub sin6_addr: [u8; 16],
+    pub sin6_scope_id: u32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct sockaddr_storage {
+    pub ss_family: sa_family_t,
+    pub __ss_padding: [u8; 126],
+}
+
+pub(crate) const O_WRONLY: c_int = 1;
+pub(crate) const O_RDWR: c_int = 2;
+pub(crate) const O_CREAT: c_int = 0o100;
+pub(crate) const O_EXCL: c_int = 0o200;
+pub(crate) const O_NOCTTY: c_int = 0o400;
+pub(crate) const O_TRUNC: c_int = 0o1000;
+pub(crate) const O_APPEND: c_int = 0o2000;
+pub(crate) const O_NONBLOCK: c_int = 0o4000;
+pub(crate) const O_DSYNC: c_int = 0o10000;
+pub(crate) const O_SYNC: c_int = 0o4010000;
+pub(crate) const O_NOFOLLOW: c_int = 0o400000;
+pub(crate) const SEEK_CUR: c_int = 1;
+pub(crate) const AT_REMOVEDIR: c_int = 0x200;
+pub(crate) const ENOSYS: c_int = 38;
+pub(crate) type in_port_t = u16;
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct statfs {
+    pub f_type: i64,
+    pub f_bsize: i64,
+    pub f_blocks: u64,
+    pub f_bfree: u64,
+    pub f_bavail: u64,
+    pub f_files: u64,
+    pub f_ffree: u64,
+    pub f_namelen: i64,
+    pub f_frsize: i64,
+    pub f_flags: i64,
+}
