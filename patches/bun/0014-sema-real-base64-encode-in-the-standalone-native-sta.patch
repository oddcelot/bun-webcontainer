From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Kopco <hey@oddcelot.dev>
Date: Wed, 28 Oct 2026 19:24:47 +0100
Subject: [PATCH] sema: real base64 encode in the standalone native stand-ins

---
 src/sema/standalone/native.rs | 34 +++++++++++++++++++++++++++++-----
 1 file changed, 29 insertions(+), 5 deletions(-)

diff --git a/src/sema/standalone/native.rs b/src/sema/standalone/native.rs
index 14329c49..6ae5399c 100644
--- a/src/sema/standalone/native.rs
+++ b/src/sema/standalone/native.rs
@@ -849,12 +849,36 @@ unsafe extern "C" fn simdutf__convert_utf16le_to_utf8_with_errors(
 }
 #[unsafe(no_mangle)]
 unsafe extern "C" fn simdutf__base64_encode(
-    _p: *const u8,
-    _len: usize,
-    _out: *mut u8,
-    _url: c_int,
+    p: *const u8,
+    len: usize,
+    out: *mut u8,
+    url: c_int,
 ) -> usize {
-    unreachable!("the parser never encodes base64")
+    // wasm-experiment: the bundler's inline source maps and data: URLs encode base64.
+    const STD: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    const URL: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+    // SAFETY: the caller passes a slice, as a pointer and a length.
+    let input = unsafe { bytes(p, len) };
+    let table = if url != 0 { URL } else { STD };
+    let mut o = Vec::with_capacity(len.div_ceil(3) * 4);
+    for c in input.chunks(3) {
+        let n = (c[0] as u32) << 16 | (*c.get(1).unwrap_or(&0) as u32) << 8 | *c.get(2).unwrap_or(&0) as u32;
+        o.push(table[(n >> 18) as usize & 63]);
+        o.push(table[(n >> 12) as usize & 63]);
+        if c.len() > 1 {
+            o.push(table[(n >> 6) as usize & 63]);
+        } else if url == 0 {
+            o.push(b'=');
+        }
+        if c.len() > 2 {
+            o.push(table[n as usize & 63]);
+        } else if url == 0 {
+            o.push(b'=');
+        }
+    }
+    // SAFETY: the caller sized `out` with `simdutf__base64_length_from_binary`.
+    unsafe { core::ptr::copy_nonoverlapping(o.as_ptr(), out, o.len()) };
+    o.len()
 }
 
 // ───────────────────────────── widths ─────────────────────────────
