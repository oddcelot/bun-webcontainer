+
+/// wasm-experiment: a single-threaded stand-in for the worker pool. `schedule` queues tasks
+/// here; whoever would block on the pool (`WaitGroup::wait`, the mini event loop tick) calls
+/// [`run_pending_one`] instead, so tasks run on the calling thread.
+#[cfg(target_family = "wasm")]
+pub(crate) mod inline {
+    use super::{Batch, Task};
+    use std::collections::VecDeque;
+
+    // Raw task pointers aren't `Send`; stored as addresses (single-threaded anyway).
+    static QUEUE: std::sync::Mutex<VecDeque<usize>> = std::sync::Mutex::new(VecDeque::new());
+
+    pub(crate) fn push(mut batch: Batch) {
+        let mut q = QUEUE.lock().unwrap();
+        while let Some(task) = batch.pop() {
+            q.push_back(task.as_ptr() as usize);
+        }
+    }
+
+    pub(crate) fn run_one() -> bool {
+        let Some(addr) = QUEUE.lock().unwrap().pop_front() else {
+            return false;
+        };
+        let task = addr as *mut Task;
+        // SAFETY: queued by `push` from a live scheduled task; the lock is released so the
+        // callback may schedule more work.
+        unsafe { ((*task).callback)(task) };
+        true
+    }
+}
+
+/// wasm-experiment: runs one queued task on the calling thread; false when none is queued.
+#[cfg(target_family = "wasm")]
+pub fn run_pending_one() -> bool {
+    inline::run_one()
+}
