-    struct State;
+    struct State {
+        buf: AlignedBuf,
+        index: usize,
+        end_index: usize,
+    }
     #[cfg(target_family = "wasm")] // wasm-experiment
     impl State {
         #[inline]
         fn new() -> State {
-            State
+            State { buf: AlignedBuf::uninit(), index: 0, end_index: 0 }
         }
-        fn next(&mut self, _dir: Fd) -> Result<Option<IteratorResult>> {
-            Err(Error::from_code(super::E::ENOSYS, Tag::getdents64))
+        /// Records come from the host as `[d_type u8][0][name_len u16 LE][name][NUL]` (wasm_impl.rs).
+        fn next(&mut self, dir: Fd) -> Result<Option<IteratorResult>> {
+            loop {
+                if self.index >= self.end_index {
+                    // SAFETY: `buf` is BUF_SIZE writable bytes; the host initializes `[0..n]`.
+                    let buf = unsafe { core::slice::from_raw_parts_mut(self.buf.as_mut_ptr(), BUF_SIZE) };
+                    let n = super::getdents_host(dir, buf)?;
+                    if n == 0 {
+                        return Ok(None);
+                    }
+                    self.index = 0;
+                    self.end_index = n;
+                }
+                // SAFETY: the host initialized `[0..end_index]`, and `end_index <= BUF_SIZE`.
+                let filled = unsafe { self.buf.filled(self.end_index) };
+                let i = self.index;
+                if i + 5 > filled.len() {
+                    return Err(Error::from_code(super::E::EINVAL, Tag::getdents64));
+                }
+                let name_len = u16::from_le_bytes([filled[i + 2], filled[i + 3]]) as usize;
+                if i + 4 + name_len + 1 > filled.len() || filled[i + 4 + name_len] != 0 {
+                    return Err(Error::from_code(super::E::EINVAL, Tag::getdents64));
+                }
+                self.index = i + 4 + name_len + 1;
+                let kind = match filled[i] {
+                    4 => EntryKind::Directory,
+                    8 => EntryKind::File,
+                    _ => EntryKind::Unknown,
+                };
+                return Ok(Some(IteratorResult {
+                    name: Name::borrow(&filled[i + 4..i + 4 + name_len]),
+                    kind,
+                    ino: 0,
+                }));
+            }
         }
     }
 
diff --git a/src/sys/wasm_impl.rs b/src/sys/wasm_impl.rs
index 3a29a4b7..29864c26 100644
--- a/src/sys/wasm_impl.rs
