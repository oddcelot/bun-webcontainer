-//! wasm-experiment: syscall surface for `target_family = "wasm"`. Every operation reports ENOSYS
-//! until it is wired to a host-provided filesystem.
+//! wasm-experiment: syscall surface for `target_family = "wasm"`. The core file operations call
+//! `bun_sys_host_*` symbols; everything else reports ENOSYS.
+//!
+//! # Host ABI (wasm64)
+//!
+//! bun_sys only *declares* the symbols below (`bun_sys_host_<name>`); the final wasm crate has to
+//! define them, like the other C stand-ins. `sys-host/` (outer repo) does: its `imports` feature
+//! forwards each to a wasm import `bun_sys.<name>`, implemented over the playground VFS by
+//! `playground/src/worker/sysHost.ts`; without the feature they return `-ENOSYS`, so a crate that
+//! never touches the filesystem stays import-free (transpile-wasm, semver-wasm).
+//!
+//! Linux numbering for errno, `O_*`, `AT_*` and the `stat` layout (see `wasm_libc.rs`).
+//! Pointers and lengths are `usize` (i64); `fd`, `dirfd`, `flags`, `mode`, `whence` are i32;
+//! offsets are i64. Every import returns i64: `>= 0` is the result, `< 0` is `-errno`.
+//! Paths are passed as `(ptr, len)` UTF-8, without NUL. `dirfd == AT_FDCWD (-100)` means the cwd,
+//! which is the VFS root "/"; absolute paths are relative to that root too.
+//!
+//! ```text
+//! open(dirfd, path, len, flags, mode)            -> fd
+//! close(fd)                                      -> 0
+//! read(fd, buf, len) / write(fd, buf, len)       -> bytes transferred
+//! pread(fd, buf, len, off) / pwrite(...)         -> bytes transferred (position untouched)
+//! lseek(fd, off, whence)                         -> new position
+//! stat(dirfd, path, len, flags, out)             -> 0   flags & AT_SYMLINK_NOFOLLOW (0x100): lstat
+//! fstat(fd, out)                                 -> 0
+//! mkdir(dirfd, path, len, mode, recursive)       -> 0   recursive != 0: like `mkdir -p`
+//! unlink(dirfd, path, len, flags)                -> 0   flags & AT_REMOVEDIR (0x200): rmdir
+//! rename(fromdir, from, flen, todir, to, tlen)   -> 0
+//! getdents(fd, buf, len)                         -> bytes of records written; 0 = end
+//! getcwd(buf, len)                               -> length written (no NUL)
+//! ```
+//!
+//! `out` of `stat`/`fstat` is a 120-byte little-endian `libc::stat` (wasm_libc.rs), `#[repr(C)]`:
+//! dev u64 @0, ino u64 @8, nlink u64 @16, mode u32 @24, uid u32 @28, gid u32 @32, rdev u64 @40,
+//! size i64 @48, blksize i64 @56, blocks i64 @64, atime i64/nsec i64 @72/@80, mtime @88/@96,
+//! ctime @104/@112.
+//!
+//! `getdents` fills `buf` with packed records `[d_type u8][0 u8][name_len u16 LE][name][NUL]`
+//! (`d_type`: 4 = dir, 8 = file) and keeps a cursor per open directory fd.
 
 use super::*;
+use core::mem::MaybeUninit;
+
+mod host {
+    unsafe extern "C" {
+        #[link_name = "bun_sys_host_open"]
+        pub(super) fn open(dirfd: i32, path: *const u8, len: usize, flags: i32, mode: u32) -> i64;
+        #[link_name = "bun_sys_host_close"]
+        pub(super) fn close(fd: i32) -> i64;
+        #[link_name = "bun_sys_host_read"]
+        pub(super) fn read(fd: i32, buf: *mut u8, len: usize) -> i64;
+        #[link_name = "bun_sys_host_write"]
+        pub(super) fn write(fd: i32, buf: *const u8, len: usize) -> i64;
+        #[link_name = "bun_sys_host_pread"]
+        pub(super) fn pread(fd: i32, buf: *mut u8, len: usize, off: i64) -> i64;
+        #[link_name = "bun_sys_host_pwrite"]
+        pub(super) fn pwrite(fd: i32, buf: *const u8, len: usize, off: i64) -> i64;
+        #[link_name = "bun_sys_host_lseek"]
+        pub(super) fn lseek(fd: i32, off: i64, whence: i32) -> i64;
+        #[link_name = "bun_sys_host_stat"]
+        pub(super) fn stat(dirfd: i32, path: *const u8, len: usize, flags: i32, out: *mut u8) -> i64;
+        #[link_name = "bun_sys_host_fstat"]
+        pub(super) fn fstat(fd: i32, out: *mut u8) -> i64;
+        #[link_name = "bun_sys_host_mkdir"]
+        pub(super) fn mkdir(dirfd: i32, path: *const u8, len: usize, mode: u32, recursive: i32) -> i64;
+        #[link_name = "bun_sys_host_unlink"]
+        pub(super) fn unlink(dirfd: i32, path: *const u8, len: usize, flags: i32) -> i64;
+        #[link_name = "bun_sys_host_rename"]
+        pub(super) fn rename(from_dir: i32, from: *const u8, flen: usize, to_dir: i32, to: *const u8, tlen: usize) -> i64;
+        #[link_name = "bun_sys_host_getdents"]
+        pub(super) fn getdents(fd: i32, buf: *mut u8, len: usize) -> i64;
+        #[link_name = "bun_sys_host_getcwd"]
+        pub(super) fn getcwd(buf: *mut u8, len: usize) -> i64;
+    }
+}
+
+const _: () = assert!(core::mem::size_of::<Stat>() == 120);
+const AT_SYMLINK_NOFOLLOW: i32 = 0x100;
+const AT_REMOVEDIR: i32 = 0x200;
 
 #[inline]
 fn enosys(tag: Tag) -> Error {
     Error::from_code(E::ENOSYS, tag)
 }
 
+/// `-errno` / result convention of the host imports.
+#[inline]
+fn ret(rc: i64, tag: Tag) -> Maybe<usize> {
+    if rc < 0 { Err(Error::from_code_int((-rc) as core::ffi::c_int, tag)) } else { Ok(rc as usize) }
+}
+
+#[inline]
+fn ret_p(rc: i64, tag: Tag, path: &[u8]) -> Maybe<usize> {
+    ret(rc, tag).map_err(|e| e.with_path(path))
+}
+
+#[inline]
+fn ret_fd(rc: i64, tag: Tag, fd: Fd) -> Maybe<usize> {
+    ret(rc, tag).map_err(|e| e.with_fd(fd))
+}
+
+fn stat_via(tag: Tag, path: &[u8], call: impl FnOnce(*mut u8) -> i64) -> Maybe<Stat> {
+    let mut st = MaybeUninit::<Stat>::uninit();
+    ret_p(call(st.as_mut_ptr().cast()), tag, path)?;
+    // SAFETY: the host wrote the full 120-byte struct on success.
+    Ok(unsafe { st.assume_init() })
+}
+
+/// One batch of directory records (format in the module docs); used by the `sys::dir` iterator.
+pub(crate) fn getdents_host(dir: Fd, buf: &mut [u8]) -> Maybe<usize> {
+    // SAFETY: `buf` is valid for `buf.len()` bytes.
+    ret_fd(unsafe { host::getdents(dir.native(), buf.as_mut_ptr(), buf.len()) }, Tag::getdents64, dir)
+}
+
 pub type FcntlInt = isize;
 
