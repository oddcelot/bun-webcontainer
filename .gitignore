# Patched upstream checkout; recreate with scripts/setup-bun.sh
/bun/

# Build output
target/
dist/
dist-canary/
dist-check/
node_modules/

# Copied in by apps/playground/scripts/copy-wasm.ts
/apps/playground/public/*.wasm

# Generated by crates/semver-wasm/gen-expected.ts (needs a local Bun)
/crates/semver-wasm/expected.json

# Screenshots taken while verifying in the browser
/apps/playground/docs-*.png

# Superseded by patches/bun/
/bun-wasm-experiment.patch

.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# wrangler local state
.wrangler/

# moon (cache and generated files)
/.moon/cache/
/.moon/docker/

# Local secrets (the GitHub App and Better Auth): apps/playground/.dev.vars, read by the dev server and pushed to the
# Worker with `wrangler secret bulk`. Never committed.
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example
