# Cloudflare Pages / Netlify: cross-origin isolation for SharedArrayBuffer (rolldown's wasm threads).
# vite dev and vite preview send the same headers (vite.config.ts).
# Origin-Agent-Cluster: each origin (the editor, the content origin) is its own agent cluster, in every browser.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Origin-Agent-Cluster: ?1

# The embed (runbun.dev/embed, framed by other sites) and the <bun-playground> element they load as a module script.
/embed
  Cross-Origin-Resource-Policy: cross-origin
/embed.js
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# The content origin (src/contentOrigin.ts; worker/index.ts answers there too): it runs project code and is framed by the
# editor under COEP, so CORP cross-origin; it never appears in search results. Absolute URLs match by host (Workers static
# assets), so these rules only apply there; the canary's host is the second. Same as vite.config.ts's originHeaders().
https://run.runbun.dev/*
  Cross-Origin-Resource-Policy: cross-origin
  X-Robots-Tag: noindex
https://run-canary.runbun.dev/*
  Cross-Origin-Resource-Policy: cross-origin
  X-Robots-Tag: noindex
# host.html may be framed by any page (an embedder frames /embed, which frames this): who may drive it is its own check of
# its parent against the build's editor origins. /host is the same page, as the assets serve it without ".html".
https://run.runbun.dev/host
  Content-Security-Policy: frame-ancestors *
https://run.runbun.dev/host.html
  Content-Security-Policy: frame-ancestors *
https://run-canary.runbun.dev/host
  Content-Security-Policy: frame-ancestors *
https://run-canary.runbun.dev/host.html
  Content-Security-Policy: frame-ancestors *
