# Cloudflare Pages / Netlify: cross-origin isolation for SharedArrayBuffer (rolldown's wasm threads).
# vite dev and vite preview send the same headers (vite.config.ts).
# Origin-Agent-Cluster: each origin (the editor, the content origin) is its own agent cluster, in every browser.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Origin-Agent-Cluster: ?1

# Vite's output: every file under /assets/ is named by its content hash (vite.config.ts), so it never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The embed (runbun.dev/embed, framed by other sites) and the <bun-playground> element they load as a module script.
/embed
  Cross-Origin-Resource-Policy: cross-origin
/embed.js
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# runbun.json's schema (vite.config.ts configSchema): editors and web IDEs on any site fetch it.
/schema/*
  Access-Control-Allow-Origin: *
  Content-Type: application/schema+json

# The content origin's rules (CORP cross-origin, noindex, host.html framable by any page) name its host, so
# hosting/configure.ts adds them for the hosting file's contentOrigin, at the end of the build or on a prebuilt copy.
