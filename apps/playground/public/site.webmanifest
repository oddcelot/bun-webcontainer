{
  "name": "runbun.dev: Bun in your browser",
  "short_name": "runbun",
  "description": "Run Bun.serve apps, install packages and edit TypeScript in a tab, built from Bun's own Rust crates compiled to wasm64.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "launch_handler": { "client_mode": "navigate-new" },
  "background_color": "#0a0a0a",
  "theme_color": "#171717",
  "categories": ["developer", "developer tools", "education", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    {
      "name": "Blank starter",
      "short_name": "Blank",
      "description": "One TypeScript file that logs to the console",
      "url": "./?example=starter-blank"
    },
    {
      "name": "Starters and examples",
      "short_name": "Examples",
      "description": "Pick a starter, an example or a GitHub repository",
      "url": "./?gallery"
    }
  ],
  "protocol_handlers": [{ "protocol": "web+runbun", "url": "./?link=%s" }],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/zip": [".zip"] },
      "launch_type": "single-client"
    }
  ]
}
