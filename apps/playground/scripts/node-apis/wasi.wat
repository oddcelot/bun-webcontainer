;; A wasm32-wasip1 command for node-apis' node:wasi cases; argv[1] picks what it does:
;;   hello  one line to stdout, one to stderr        args   argv, then the environment, a line each
;;   files  reads in.txt from the first preopen, writes sub/out.txt, prints errnos and sizes
;;   stdin  copies stdin to stdout                     clock  the clocks and random_get
;;   exit   proc_exit(7)                               trap   unreachable
;; Built with `wasm-tools parse wasi.wat -o wasi.wasm` (the .wasm is committed too: the cases read it).
(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $fd_read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $fd_close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_filestat_get" (func $fd_filestat_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_prestat_get" (func $fd_prestat_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_prestat_dir_name" (func $fd_prestat_dir_name (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_open" (func $path_open (param i32 i32 i32 i32 i32 i64 i64 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_create_directory" (func $path_create_directory (param i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "path_filestat_get" (func $path_filestat_get (param i32 i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_sizes_get" (func $args_sizes_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "args_get" (func $args_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_sizes_get" (func $environ_sizes_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "environ_get" (func $environ_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "clock_time_get" (func $clock_time_get (param i32 i64 i32) (result i32)))
  (import "wasi_snapshot_preview1" "random_get" (func $random_get (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (memory (export "memory") 1)
  ;; 0 iovec, 8 nwritten, 16 argc/argv size, 24 env count/size, 32 prestat, 40 dir name, 48 an fd or a time,
  ;; 64 strings, 1024 argv, 2048 argv bytes, 8192 environ, 12288 environ bytes, 16384 io buffer, 20480 filestat
  (data (i32.const 64) "\n")
  (data (i32.const 72) "hello from wasi\n")
  (data (i32.const 96) "to stderr\n")
  (data (i32.const 112) "in.txt")
  (data (i32.const 120) "sub")
  (data (i32.const 128) "sub/out.txt")
  (data (i32.const 144) "written by wasm\n")
  (data (i32.const 168) "missing.txt")
  (data (i32.const 184) "../escape.txt")
  (data (i32.const 200) "in.txt/x")
  (data (i32.const 208) " ")

  (func $write (param $fd i32) (param $ptr i32) (param $len i32)
    (i32.store (i32.const 0) (local.get $ptr))
    (i32.store (i32.const 4) (local.get $len))
    (drop (call $fd_write (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8))))
  (func $nl (call $write (i32.const 1) (i32.const 64) (i32.const 1)))
  (func $sp (call $write (i32.const 1) (i32.const 208) (i32.const 1)))
  (func $strlen (param $p i32) (result i32) (local $n i32)
    (block $done (loop $l
      (br_if $done (i32.eqz (i32.load8_u (i32.add (local.get $p) (local.get $n)))))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br $l)))
    (local.get $n))
  (func $puts (param $p i32) (call $write (i32.const 1) (local.get $p) (call $strlen (local.get $p))) (call $nl))
  ;; a number in decimal, then a space
  (func $num (param $v i64) (local $p i32)
    (local.set $p (i32.const 1000))
    (loop $l
      (local.set $p (i32.sub (local.get $p) (i32.const 1)))
      (i32.store8 (local.get $p) (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $v) (i64.const 10)))))
      (local.set $v (i64.div_u (local.get $v) (i64.const 10)))
      (br_if $l (i64.ne (local.get $v) (i64.const 0))))
    (call $write (i32.const 1) (local.get $p) (i32.sub (i32.const 1000) (local.get $p)))
    (call $sp))
  (func $errno (param $e i32) (call $num (i64.extend_i32_u (local.get $e))))
  ;; path_open under the first preopen (fd 3); the errno, and the fd at 48
  (func $open (param $p i32) (param $len i32) (param $oflags i32) (result i32)
    (call $path_open (i32.const 3) (i32.const 0) (local.get $p) (local.get $len) (local.get $oflags)
      (i64.const -1) (i64.const -1) (i32.const 0) (i32.const 48)))
  (func $each (param $count i32) (param $ptrs i32) (local $i i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (call $puts (i32.load (i32.add (local.get $ptrs) (i32.shl (local.get $i) (i32.const 2)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))

  (func $files (local $fd i32) (local $n i32) (local $e i32)
    ;; the preopen's name
    (call $errno (call $fd_prestat_get (i32.const 3) (i32.const 32)))
    (drop (call $fd_prestat_dir_name (i32.const 3) (i32.const 40) (i32.load (i32.const 36))))
    (call $write (i32.const 1) (i32.const 40) (i32.load (i32.const 36)))
    (call $nl)
    ;; in.txt
    (call $errno (call $open (i32.const 112) (i32.const 6) (i32.const 0)))
    (local.set $fd (i32.load (i32.const 48)))
    (i32.store (i32.const 0) (i32.const 16384))
    (i32.store (i32.const 4) (i32.const 4096))
    (local.set $e (call $fd_read (local.get $fd) (i32.const 0) (i32.const 1) (i32.const 8)))
    (local.set $n (i32.load (i32.const 8)))
    (call $errno (local.get $e))
    (call $write (i32.const 1) (i32.const 16384) (local.get $n))
    (call $nl)
    (call $errno (call $fd_close (local.get $fd)))
    (call $nl)
    ;; sub/out.txt: O_CREAT | O_TRUNC
    (call $errno (call $path_create_directory (i32.const 3) (i32.const 120) (i32.const 3)))
    (call $errno (call $path_create_directory (i32.const 3) (i32.const 120) (i32.const 3)))
    (call $errno (call $open (i32.const 128) (i32.const 11) (i32.const 9)))
    (local.set $fd (i32.load (i32.const 48)))
    (call $write (local.get $fd) (i32.const 144) (i32.const 16))
    (call $write (local.get $fd) (i32.const 144) (i32.const 16))
    (call $errno (call $fd_filestat_get (local.get $fd) (i32.const 20480)))
    (call $num (i64.load (i32.const 20512)))
    (call $errno (call $fd_close (local.get $fd)))
    (call $errno (call $path_filestat_get (i32.const 3) (i32.const 0) (i32.const 128) (i32.const 11) (i32.const 20480)))
    (call $num (i64.extend_i32_u (i32.load8_u (i32.const 20496))))
    (call $num (i64.load (i32.const 20512)))
    (call $nl)
    ;; errors: missing, outside the preopen, a file as a directory, an existing directory
    (call $errno (call $open (i32.const 168) (i32.const 11) (i32.const 0)))
    (call $errno (call $open (i32.const 184) (i32.const 13) (i32.const 0)))
    (call $errno (call $open (i32.const 200) (i32.const 8) (i32.const 0)))
    (call $errno (call $open (i32.const 120) (i32.const 3) (i32.const 5)))
    (call $nl))

  (func $stdin (local $n i32)
    (loop $l
      (i32.store (i32.const 0) (i32.const 16384))
      (i32.store (i32.const 4) (i32.const 4096))
      (drop (call $fd_read (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 8)))
      (local.set $n (i32.load (i32.const 8)))
      (if (local.get $n) (then
        (call $write (i32.const 1) (i32.const 16384) (local.get $n))
        (br $l)))))

  (func $clock
    (call $errno (call $clock_time_get (i32.const 0) (i64.const 1) (i32.const 48)))
    (call $num (i64.extend_i32_u (i64.gt_u (i64.load (i32.const 48)) (i64.const 1700000000000000000))))
    (call $errno (call $clock_time_get (i32.const 1) (i64.const 1) (i32.const 48)))
    (call $num (i64.extend_i32_u (i64.gt_u (i64.load (i32.const 48)) (i64.const 0))))
    (call $errno (call $random_get (i32.const 16384) (i32.const 64)))
    (call $nl))

  (func (export "_start") (local $mode i32)
    (drop (call $args_sizes_get (i32.const 16) (i32.const 20)))
    (drop (call $args_get (i32.const 1024) (i32.const 2048)))
    (if (i32.gt_u (i32.load (i32.const 16)) (i32.const 1))
      (then (local.set $mode (i32.load8_u (i32.load (i32.const 1028))))))
    ;; h(ello) a(rgs) f(iles) s(tdin) c(lock) e(xit) t(rap)
    (if (i32.eq (local.get $mode) (i32.const 104)) (then
      (call $write (i32.const 1) (i32.const 72) (i32.const 16))
      (call $write (i32.const 2) (i32.const 96) (i32.const 10))))
    (if (i32.eq (local.get $mode) (i32.const 97)) (then
      (call $each (i32.load (i32.const 16)) (i32.const 1024))
      (drop (call $environ_sizes_get (i32.const 24) (i32.const 28)))
      (drop (call $environ_get (i32.const 8192) (i32.const 12288)))
      (call $each (i32.load (i32.const 24)) (i32.const 8192))))
    (if (i32.eq (local.get $mode) (i32.const 102)) (then (call $files)))
    (if (i32.eq (local.get $mode) (i32.const 115)) (then (call $stdin)))
    (if (i32.eq (local.get $mode) (i32.const 99)) (then (call $clock)))
    (if (i32.eq (local.get $mode) (i32.const 101)) (then (call $proc_exit (i32.const 7))))
    (if (i32.eq (local.get $mode) (i32.const 116)) (then unreachable))))
