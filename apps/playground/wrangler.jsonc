// Everything runs in the browser from static assets (public/_headers, copied into dist/, sets COOP/COEP).
// The Worker only handles opt-in short links (POST /api/short, GET /s/<id>; KV LINKS) and feedback (POST /api/feedback;
// D1 FEEDBACK, schema in worker/migrations/); worker/index.ts.
{
  "name": "bun-playground",
  "compatibility_date": "2026-10-28",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "kv_namespaces": [{ "binding": "LINKS", "id": "af919e62d9334718b4e63cf62eb5bb28" }],
  // Feedback is other data than links, kept for another time, and wants queries (ratings per page): its own D1 database.
  // `bunx wrangler d1 migrations apply FEEDBACK --remote [--env canary]` after adding a migration.
  "d1_databases": [{ "binding": "FEEDBACK", "database_name": "runbun-feedback", "database_id": "6799b822-f0fd-4c6e-9bc1-03fbc4c3a609", "migrations_dir": "worker/migrations" }],
  // New short links per client IP: 10 a minute keeps the Free plan's 1,000 KV writes a day for real use.
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Feedback and page ratings per client IP: plenty for a person, and it caps the KV writes a script can burn.
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  // The docs post page ratings and feedback from their own origin (worker/index.ts allows it with CORS).
  "vars": { "DOCS_ORIGIN": "https://docs.runbun.dev" },
  "routes": [{ "pattern": "runbun.dev", "custom_domain": true }],
  // Only the custom domain: a workers.dev or preview-URL copy would be a duplicate site for search engines.
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    // `moon run playground:deploy-canary`: worker bun-playground-canary on canary.runbun.dev, built into dist-canary/
    // with the docs-canary cross-links. routes is inherited, so it must be set here; bindings are not, so repeat them.
    "canary": {
      "assets": {
        "directory": "./dist-canary",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/s/*"]
      },
      "kv_namespaces": [{ "binding": "LINKS", "id": "5823c967357a4e149e3fd4347898c0a2" }],
      "d1_databases": [
        { "binding": "FEEDBACK", "database_name": "runbun-feedback-canary", "database_id": "128b1ceb-ded6-43aa-84e1-d1ab8e9d337c", "migrations_dir": "worker/migrations" }
      ],
      "ratelimits": [
        { "name": "CREATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "FEEDBACK_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
      ],
      "vars": { "DOCS_ORIGIN": "https://docs-canary.runbun.dev" },
      "routes": [{ "pattern": "canary.runbun.dev", "custom_domain": true }]
    }
  }
}
