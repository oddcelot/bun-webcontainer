  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "WebWorker"],
    "types": [],
    "paths": { "#sw-page": ["./src/swPage.sw.d.ts"] }
  },
  "include": ["src/sw.ts", "src/swPage.sw.d.ts"],
  "exclude": []
}
