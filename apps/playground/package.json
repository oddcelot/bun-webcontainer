{
  "name": "bun-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun scripts/copy-wasm.ts",
    "prebuild": "bun scripts/copy-wasm.ts --strip",
    "dev": "vite",
    "build": "tsrs --noEmit && tsrs -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsrs --noEmit && tsrs -p tsconfig.sw.json",
    "og": "bun scripts/og.ts",
    "typecheck:worker": "wrangler types worker/worker-configuration.d.ts && tsrs -p worker",
    "swatches": "bun scripts/theme-swatches.ts"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.4",
    "@napi-rs/wasm-runtime": "1.2.6",
    "@noble/hashes": "^2.4.0",
    "@pierre/diffs": "^1.6.2",
    "@pierre/highlights": "0.3.0",
    "@pierre/theming": "1.0.2",
    "@pierre/trees": "^1.0.0-beta.6",
    "@rolldown/browser": "1.2.16",
    "@runbun/vfs": "workspace:*",
    "@solid-primitives/storage": "5.0.0-next.7",
    "@solidjs/web": "catalog:",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "abort-controller": "^3.0.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "process": "^0.11.10",
    "readable-stream": "^4.8.0",
    "solid-js": "catalog:",
    "sql.js": "^1.15.2",
    "string_decoder": "^1.3.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "@runbun/ui": "workspace:*",
    "@solidjs/vite-plugin": "catalog:",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/readable-stream": "^4.0.25",
    "@types/sql.js": "^1.4.11",
    "bun-types": "1.4.4",
    "rolldown": "1.2.16",
    "satori": "^0.63.2",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "undici-types": "8.12.3",
    "unocss": "catalog:",
    "vite": "^8.3.5"
  }
}
