---
// The scheme switch, in place of Starlight's light/dark select: the landing page's moon (by day) or sun (by night), over
// Starlight's own scheme (`data-theme` on <html>, kept in localStorage as `starlight-theme`; its ThemeProvider applies it
// before the first paint). Styled in styles/theme.css. The mobile menu shows a second one.
---

<button type="button" class="scheme-switch" aria-label="Switch between day and night"></button>

<script>
  const html = document.documentElement;
  const label = () => {
    for (const button of document.querySelectorAll(".scheme-switch")) button.setAttribute("aria-label", html.dataset.theme === "light" ? "Switch to night" : "Switch to day");
  };
  label();
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest(".scheme-switch")) return;
    html.dataset.theme = html.dataset.theme === "light" ? "dark" : "light";
    try {
      localStorage.setItem("starlight-theme", html.dataset.theme);
    } catch {}
    label();
  });
</script>
