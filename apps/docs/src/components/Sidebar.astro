---
// The sidebar in two parts, so it isn't one long list: the top-level sections (astro.config.ts's sidebar groups, and
// Privacy) as pixel game buttons, then only the current section's pages. A section opens on its first page.
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";

type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];

const { sidebar } = Astro.locals.starlightRoute;

// Each section's dumpling (a face of @runbun/ui's dumplings.png, [x, y]): the cook for the examples, the reader for
// the reference; the others are the faces the landing page's boxes use.
const FACES: Record<string, [number, number]> = {
  Guides: [2, 1],
  Examples: [6, 1],
  Reference: [1, 7],
  Compatibility: [4, 1],
  Compare: [0, 4],
  Privacy: [3, 7],
};

const hasCurrent = (entry: Entry): boolean =>
  entry.type === "link" ? entry.isCurrent : entry.entries.some(hasCurrent);
const firstHref = (entry: Entry): string | undefined =>
  entry.type === "link" ? entry.href : entry.entries.map(firstHref).find(Boolean);

// The section holding this page; the first one on a page outside the sidebar (the 404 page).
const current = sidebar.find(hasCurrent) ?? sidebar[0];
---

<SidebarPersister>
  <nav class="sections" aria-label="Sections">
    {
      sidebar.map((entry) => (
        <a href={firstHref(entry)} aria-current={entry === current ? "true" : undefined}>
          <span class="button">
            <span class="face" style={`--x: ${FACES[entry.label]?.[0] ?? 0}; --y: ${FACES[entry.label]?.[1] ?? 0}`} aria-hidden="true" />
            <span class="label">{entry.label}</span>
          </span>
        </a>
      ))
    }
  </nav>
  {
    current?.type === "group" && (
      <div class="pages">
        <SidebarSublist sublist={current.entries} nested />
      </div>
    )
  }
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  /*
   * Pixel game buttons: corners stepped in --step pixels (clip-path), an outline (.button's own background) around the
   * fill (::before, the same shape inset by one step), glints top left and bottom right (::after) and a hard shadow (the
   * link's drop-shadow, outside the clip). Quiet in the theme's control colors; the current section is Bun's pink,
   * pressed into its shadow.
   */
  .sections {
    --step: 3px;
    --ink: #15151f;
    --pill: polygon(
      0 calc(2 * var(--step)),
      var(--step) calc(2 * var(--step)),
      var(--step) var(--step),
      calc(2 * var(--step)) var(--step),
      calc(2 * var(--step)) 0,
      calc(100% - 2 * var(--step)) 0,
      calc(100% - 2 * var(--step)) var(--step),
      calc(100% - var(--step)) var(--step),
      calc(100% - var(--step)) calc(2 * var(--step)),
      100% calc(2 * var(--step)),
      100% calc(100% - 2 * var(--step)),
      calc(100% - var(--step)) calc(100% - 2 * var(--step)),
      calc(100% - var(--step)) calc(100% - var(--step)),
      calc(100% - 2 * var(--step)) calc(100% - var(--step)),
      calc(100% - 2 * var(--step)) 100%,
      calc(2 * var(--step)) 100%,
      calc(2 * var(--step)) calc(100% - var(--step)),
      var(--step) calc(100% - var(--step)),
      var(--step) calc(100% - 2 * var(--step)),
      0 calc(100% - 2 * var(--step))
    );

    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0 calc(2 * var(--step)) 1.5rem 0;

    a {
      --fill: var(--control);
      --edge: color-mix(in srgb, var(--fg) 28%, var(--bg));
      --glint: color-mix(in srgb, #fff 35%, transparent);

      display: block;
      color: var(--fg);
      text-decoration: none;
      filter: drop-shadow(var(--step) var(--step) 0 var(--edge));

      &:hover {
        --fill: var(--control-hover);
      }

      &:focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 4px;
      }

      /* Near-black outline and label on the pink, as in pixel game art; a dark pink edge on a dark page, where
       * near-black would vanish into the sidebar. */
      &[aria-current="true"] {
        --fill: var(--brand);
        --edge: var(--ink);
        --glint: #fff;

        color: var(--ink);
        filter: none;
        translate: var(--step) var(--step);
      }
    }

    .button {
      position: relative;
      display: flex;
      gap: 0.6rem;
      align-items: center;
      padding: 4px 14px;
      background: var(--edge);
      clip-path: var(--pill);

      &::before {
        content: "";
        position: absolute;
        inset: var(--step);
        background: var(--fill);
        clip-path: var(--pill);
      }

      /* The glints: a dash and a dot top left, a dot and a dash bottom right. */
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(var(--glint), var(--glint)) calc(4 * var(--step)) calc(2 * var(--step)) / calc(5 * var(--step)) var(--step) no-repeat,
          linear-gradient(var(--glint), var(--glint)) calc(10 * var(--step)) calc(2 * var(--step)) / var(--step) var(--step) no-repeat,
          linear-gradient(var(--glint), var(--glint)) right calc(10 * var(--step)) bottom calc(2 * var(--step)) / var(--step) var(--step) no-repeat,
          linear-gradient(var(--glint), var(--glint)) right calc(4 * var(--step)) bottom calc(2 * var(--step)) / calc(4 * var(--step)) var(--step) no-repeat;
        opacity: 0.85;
        pointer-events: none;
      }

      > * {
        position: relative;
        z-index: 1;
      }
    }

    .face {
      flex: none;
      width: 32px;
      height: 32px;
      background: url("@runbun/ui/assets/dumplings.png") calc(var(--x) * 100% / 7) calc(var(--y) * 100% / 7) / 800% 800%;
      image-rendering: pixelated;
    }

    .label {
      font: 0.5625rem/1.4 var(--font-pixel-label);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
  }

  :global(:root:not([data-theme="light"])) .sections a[aria-current="true"] {
    --edge: color-mix(in srgb, var(--brand) 40%, #000);
  }

  @media (prefers-reduced-motion: reduce) {
    .sections a[aria-current="true"] {
      translate: none;
    }
  }

  /* The section's pages hang off a guide line, like a group's would. */
  .pages {
    margin-inline-start: 0.75rem;
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--border);
  }
</style>
