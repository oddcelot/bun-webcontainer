---
// The sidebar in two parts, so it isn't one long list: a card with the top-level sections (astro.config.ts's sidebar
// groups, and Privacy), then only the current section's pages. A section opens on its first page.
import MobileMenuFooter from "virtual:starlight/components/MobileMenuFooter";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";

type Entry = (typeof Astro.locals.starlightRoute.sidebar)[number];

const { sidebar } = Astro.locals.starlightRoute;

// Each section's dumpling (a face of @runbun/ui's dumplings.png, [x, y]); the landing page's boxes use the same ones.
const FACES: Record<string, [number, number]> = {
  Guides: [2, 1],
  Examples: [6, 0],
  Reference: [6, 1],
  Compatibility: [4, 1],
  Compare: [0, 4],
  Privacy: [3, 7],
};

const hasCurrent = (entry: Entry): boolean =>
  entry.type === "link" ? entry.isCurrent : entry.entries.some(hasCurrent);
const firstHref = (entry: Entry): string | undefined =>
  entry.type === "link" ? entry.href : entry.entries.map(firstHref).find(Boolean);

// The section holding this page; the first one on a page outside the sidebar (the 404 page).
const current = sidebar.find(hasCurrent) ?? sidebar[0];
---

<SidebarPersister>
  <nav class="sections" aria-label="Sections">
    {
      sidebar.map((entry) => (
        <a href={firstHref(entry)} aria-current={entry === current ? "true" : undefined}>
          <span class="face" style={`--x: ${FACES[entry.label]?.[0] ?? 0}; --y: ${FACES[entry.label]?.[1] ?? 0}`} aria-hidden="true" />
          <span>{entry.label}</span>
        </a>
      ))
    }
  </nav>
  {
    current?.type === "group" && (
      <div class="pages">
        <SidebarSublist sublist={current.entries} nested />
      </div>
    )
  }
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  /* The section card: a darker panel in a quiet pixel frame; the current section is outlined in Bun's pink. */
  .sections {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: var(--px) var(--px) 1.25rem;
    padding: 6px;
    background: var(--bg);
    box-shadow:
      0 calc(-1 * var(--px)) 0 0 var(--border),
      0 var(--px) 0 0 var(--border),
      calc(-1 * var(--px)) 0 0 0 var(--border),
      var(--px) 0 0 0 var(--border);

    a {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      padding: 0.2rem 0.65rem;
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-sm);
      font-weight: 600;
      text-decoration: none;

      .face {
        flex: none;
        width: 32px;
        height: 32px;
        background: url("@runbun/ui/assets/dumplings.png") calc(var(--x) * 100% / 7) calc(var(--y) * 100% / 7) / 800% 800%;
        image-rendering: pixelated;
      }

      &:hover {
        background: var(--control);
        color: var(--fg);
      }

      &[aria-current="true"] {
        box-shadow: inset 0 0 0 2px var(--brand);
        color: var(--fg);
      }
    }
  }

  /* The section's pages hang off a guide line, like a group's would. */
  .pages {
    margin-inline-start: 0.75rem;
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--border);
  }
</style>
