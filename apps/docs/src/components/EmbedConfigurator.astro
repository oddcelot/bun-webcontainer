---
// The embed configurator lives in the playground (playground/configure.html), built from its own components and
// theme; this frames it, wide enough for the form beside the live embed. It wears the reader's scheme and theme family
// (ThemeProvider.astro): they go in the frame's URL, and to the frame as a message when they change.
import { PLAYGROUND_URL } from "../../site-urls.ts";

const src = `${PLAYGROUND_URL}configure`;
---

<div class="not-content configurator">
  <iframe data-src={src} title="Embed configurator" allow="clipboard-write"></iframe>
  <p><a href={src}>Open the configurator on its own page</a></p>
</div>

<script>
  const frame = document.querySelector<HTMLIFrameElement>(".configurator iframe")!;
  const base = new URL(frame.dataset.src!);
  const html = document.documentElement;
  const look = () => ({ theme: html.dataset.theme === "light" ? "light" : "dark", family: html.dataset.family ?? "" });
  // The URL carries the look at load, so the frame paints in it from the start.
  const url = new URL(base);
  for (const [k, v] of Object.entries(look())) if (v) url.searchParams.set(k, v);
  frame.src = url.href;
  new MutationObserver(() => frame.contentWindow?.postMessage({ bunConfigure: 1, ...look() }, base.origin)).observe(html, {
    attributes: true,
    attributeFilter: ["data-theme", "data-family"],
  });
</script>

<style>
  /* This page gets a wider content column, so the form and the preview fit side by side. */
  :global(:root:has(.configurator)) {
    --sl-content-width: 96rem;
  }
  .configurator {
    margin-top: 1.5rem;
  }
  iframe {
    display: block;
    width: 100%;
    height: max(44rem, calc(100vh - var(--sl-nav-height) - 6rem));
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }
  p {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
</style>
