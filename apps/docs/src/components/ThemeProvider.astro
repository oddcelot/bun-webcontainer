---
// Starlight's theme script (light/dark), plus the theme family: `data-family` (the family's light variant, from the
// appearance picker in ThemeSelect.astro) and `data-code-theme` (its variant for the scheme in effect, which the code
// blocks' colors follow). Inline, so the first paint is already in the reader's family.
import Default from "@astrojs/starlight/components/ThemeProvider.astro";
import { DEFAULT_FAMILY, FAMILIES } from "../../../../ui/uno.preset";

const darkOf = Object.fromEntries(FAMILIES.map((f) => [f.light, f.dark]));
---

<Default />
<script is:inline define:vars={{ darkOf, fallback: DEFAULT_FAMILY }}>
  const html = document.documentElement;
  let family = null;
  try {
    family = localStorage.getItem("docs-family");
  } catch {}
  html.dataset.family = family && darkOf[family] ? family : fallback;
  const sync = () => {
    const f = darkOf[html.dataset.family] ? html.dataset.family : fallback;
    html.dataset.codeTheme = html.dataset.theme === "light" ? f : darkOf[f];
  };
  sync();
  new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ["data-theme", "data-family"] });
</script>
