---
// Starlight's social links, a Sponsor key (GitHub Sponsors, a pixel heart) and an "Open playground" link, drawn as the
// pink key (src/styles/theme.css). `?open` takes a first-time visitor into the playground itself, not to its landing
// page (apps/playground/index.html).
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { PLAYGROUND_URL } from "../../site-urls.ts";
---

<Default />
<a class="sponsor" href="https://github.com/sponsors/oddcelot" aria-label="Sponsor" title="Sponsor">
  <svg viewBox="0 0 7 6" width="14" height="12" aria-hidden="true" shape-rendering="crispEdges">
    <path d="M1 0h2v1h1V0h2v1h1v2H6v1H5v1H4v1H3V5H2V4H1V3H0V1h1z" fill="currentColor" />
  </svg>
</a>
<a class="open-playground" href={`${PLAYGROUND_URL}?open`}>
  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 4v16l13-8z" fill="currentColor" /></svg>
  Open playground
</a>
