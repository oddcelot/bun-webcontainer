// Static docs site on docs.runbun.dev; no Worker code, only assets.
{
  "name": "bun-playground-docs",
  "compatibility_date": "2026-10-28",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "docs.runbun.dev", "custom_domain": true }],
  // Only the custom domain: a workers.dev or preview-URL copy would be a duplicate site for search engines.
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    // `moon run docs:deploy-canary`: bun-playground-docs-canary on docs-canary.runbun.dev, built into dist-canary/.
    "canary": {
      "assets": { "directory": "./dist-canary", "not_found_handling": "404-page" },
      "routes": [{ "pattern": "docs-canary.runbun.dev", "custom_domain": true }]
    }
  }
}
