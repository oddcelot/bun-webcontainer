---
// A code block for .mdx pages, highlighted at build time with @pierre/highlights (src/highlight.mjs) in the reader's
// code theme. Static by default; with `playground` it gets a Run button that turns it into an embed (Playground.astro)
// with the code as its file, and every embed option passes through. `title` names the file, as in a fence.
import type { ComponentProps } from "astro/types";
import { highlight } from "../highlight.mjs";
import Playground from "./Playground.astro";

type Props = Omit<ComponentProps<typeof Playground>, "title"> & {
  code: string;
  lang?: string;
  title?: string;
  playground?: boolean;
};
const { code, lang = "ts", title, playground, files, load = "click", expand = "full", ...options } = Astro.props;
const EXT: Record<string, string> = { typescript: "ts", javascript: "js", shell: "sh", bash: "sh", jsonc: "json" };
const file = title || `index.${EXT[lang] ?? lang}`;
const html = highlight(code.replace(/\n$/, ""), lang);
const href = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}highlights.css`;
---

<link rel="stylesheet" href={href} />
{
  playground ? (
    <Playground {...options} load={load} expand={expand} files={{ [file]: code, ...files }}>
      <figure class="code not-content">
        {title && <figcaption>{title}</figcaption>}
        <Fragment set:html={html} />
      </figure>
    </Playground>
  ) : (
    <figure class="code not-content">
      {title && <figcaption>{title}</figcaption>}
      <Fragment set:html={html} />
    </figure>
  )
}

<style>
  /* Starlight's content flow still spaces it from its neighbors. */
  :where(.code) {
    margin: 0;
  }
  .code {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--hls-background);
    color: var(--hls-foreground);
  }
  figcaption {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    opacity: 0.8;
  }
  .code :global(pre) {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-code);
    line-height: var(--sl-line-height);
  }
</style>
