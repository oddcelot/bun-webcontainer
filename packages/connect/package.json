{
  "name": "@runbun/connect",
  "version": "0.5.0",
  "description": "Run runbun.dev playground code with the real Bun on your own machine, sandboxed: bunx @runbun/connect --open",
  "type": "module",
  "license": "MIT",
  "keywords": ["bun", "playground", "runbun", "sandbox", "bubblewrap", "local-runner"],
  "homepage": "https://docs.runbun.dev/guides/local-bun/",
  "repository": { "type": "git", "url": "git+https://github.com/oddcelot/bun-webcontainer.git", "directory": "packages/connect" },
  "bugs": "https://github.com/oddcelot/bun-webcontainer/issues",
  "funding": "https://github.com/sponsors/oddcelot",
  "bin": {
    "runbun-connect": "src/cli.ts"
  },
  "exports": {
    "./protocol": "./src/protocol.ts"
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "bun": ">=1.3" },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test.ts"
  },
  "publishConfig": { "access": "public" }
}
