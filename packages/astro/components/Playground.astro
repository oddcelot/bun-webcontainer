---
// A runnable embed. The default slot is the poster (shown until the embed is ready); `files` become inline sources.
// In Markdown, ```ts playground fences do the same (../dist/remark.js).
import "virtual:@runbun/astro/blocks.css";
import { config } from "virtual:@runbun/astro/config";
import { codeBlock, copyScript, embedScripts, fileScript, langOf, presetRequests, requestPanel } from "../dist/markup.js";

export interface Props {
  mode?: "code" | "preview" | "console" | "full" | "result";
  features?: string;
  file?: string;
  /** What the preview requests first (default: `/`), e.g. `/user/123`. */
  path?: string;
  /**
   * Requests a reader can try, a preview tab each, the first active: `;`-separated `METHOD /path [body]`, e.g.
   * `GET /; POST /form {"hello":"Elysia"}`. Wins over `path`. `GET / => Hello` adds the response the author expects:
   * the poster shows it under the code before Run, and the embed gets the requests alone.
   */
  requests?: string;
  /** "stack": the preview (or console) under the editor instead of beside it. */
  layout?: "side" | "stack";
  autorun?: boolean;
  theme?: string;
  readonly?: boolean;
  persist?: string;
  example?: string;
  repo?: string;
  share?: string;
  load?: "eager" | "visible" | "click";
  height?: string;
  title?: string;
  /** A button that opens the embed in a modal: true, or a mode to switch to while open ("full"). */
  expand?: boolean | "code" | "preview" | "console" | "full" | "result";
  files?: Record<string, string>;
  /** Names in `files` that run but don't open as tabs (`data-hidden`), e.g. a generated package.json. */
  hidden?: string[];
}
const { files = {}, hidden = [], load = "click", ...attrs } = Astro.props;
const bool = (v: unknown) => (v === undefined ? undefined : v ? "" : undefined);
// Written responses (`=>`): a request panel under the poster's code, and the requests alone for the embed. Its radio
// name counts the page's panels (Astro.locals is per render), apart from the fence plugin's. Without a poster of its
// own, the poster is the first shown file's block, with the Copy script (once per page). The blocks' stylesheet is
// imported above, so Astro bundles it into the page's CSS as for <Code> (one copy for both).
const presets = attrs.requests === undefined ? undefined : presetRequests(attrs.requests);
const locals = Astro.locals as Record<symbol, unknown>;
let panel = "";
let code = "";
if (presets?.responses) {
  const PANELS = Symbol.for("runbun.requests");
  const k = (locals[PANELS] = ((locals[PANELS] as number | undefined) ?? 0) + 1);
  panel = requestPanel(presets.entries, `runbun-code-requests-${k}`);
  if (!Astro.slots.has("default")) {
    const [name, text] = Object.entries(files).find(([path]) => !hidden.includes(path)) ?? ["", ""];
    code = codeBlock(text, langOf(name));
  }
  const COPY = Symbol.for("runbun.copy");
  panel += locals[COPY] ? "" : copyScript();
  locals[COPY] = true;
}
---

<!-- not-content: Starlight's spacing between content elements would push the poster down below the file scripts. -->
<bun-playground
  class="not-content"
  load={load}
  mode={attrs.mode}
  features={attrs.features}
  file={attrs.file}
  path={attrs.path}
  requests={presets?.responses ? presets.attr : attrs.requests}
  layout={attrs.layout}
  autorun={attrs.autorun === undefined ? undefined : String(attrs.autorun)}
  theme={attrs.theme}
  readonly={bool(attrs.readonly)}
  persist={attrs.persist}
  example={attrs.example}
  repo={attrs.repo}
  share={attrs.share}
  height={attrs.height}
  title={attrs.title}
  expand={attrs.expand === undefined || attrs.expand === false ? undefined : attrs.expand === true ? "" : attrs.expand}
>
  <Fragment set:html={Object.entries(files).map(([path, text]) => fileScript(path, text, hidden.includes(path))).join("\n")} />
  {/* Without a poster of its own, the element shows the first file's code. */}
  {
    panel ? (
      <div slot="poster">
        {Astro.slots.has("default") ? <slot /> : <Fragment set:html={code} />}
        <Fragment set:html={panel} />
      </div>
    ) : (
      Astro.slots.has("default") && (
        <div slot="poster">
          <slot />
        </div>
      )
    )
  }
</bun-playground>
<Fragment set:html={embedScripts(config.playgroundUrl, config.sync)} />
