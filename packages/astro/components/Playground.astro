---
// A runnable embed. The default slot is the poster (shown until the embed is ready); `files` become inline sources.
// In Markdown, ```ts playground fences do the same (../dist/remark.js).
import { config } from "virtual:@runbun/astro/config";
import { embedScripts, fileScript } from "../dist/markup.js";

export interface Props {
  mode?: "code" | "preview" | "console" | "full" | "result";
  features?: string;
  file?: string;
  autorun?: boolean;
  theme?: string;
  readonly?: boolean;
  persist?: string;
  example?: string;
  repo?: string;
  share?: string;
  load?: "eager" | "visible" | "click";
  height?: string;
  title?: string;
  /** A button that opens the embed in a modal: true, or a mode to switch to while open ("full"). */
  expand?: boolean | "code" | "preview" | "console" | "full" | "result";
  files?: Record<string, string>;
}
const { files = {}, load = "click", ...attrs } = Astro.props;
const bool = (v: unknown) => (v === undefined ? undefined : v ? "" : undefined);
---

<!-- not-content: Starlight's spacing between content elements would push the poster down below the file scripts. -->
<bun-playground
  class="not-content"
  load={load}
  mode={attrs.mode}
  features={attrs.features}
  file={attrs.file}
  autorun={attrs.autorun === undefined ? undefined : String(attrs.autorun)}
  theme={attrs.theme}
  readonly={bool(attrs.readonly)}
  persist={attrs.persist}
  example={attrs.example}
  repo={attrs.repo}
  share={attrs.share}
  height={attrs.height}
  title={attrs.title}
  expand={attrs.expand === undefined || attrs.expand === false ? undefined : attrs.expand === true ? "" : attrs.expand}
>
  <Fragment set:html={Object.entries(files).map(([path, text]) => fileScript(path, text)).join("\n")} />
  {/* Without a poster of its own, the element shows the first file's code. */}
  {Astro.slots.has("default") && <div slot="poster"><slot /></div>}
</bun-playground>
<Fragment set:html={embedScripts(config.playgroundUrl, config.sync)} />
