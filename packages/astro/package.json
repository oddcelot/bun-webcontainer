{
  "name": "@runbun/astro",
  "version": "0.1.1",
  "description": "Code blocks highlighted with @pierre/highlights that turn into a runnable Bun playground (runbun.dev) on click.",
  "type": "module",
  "license": "MIT",
  "keywords": ["astro-integration", "astro-component", "bun", "playground", "code", "highlight"],
  "homepage": "https://docs.runbun.dev/guides/astro/",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./remark": { "types": "./dist/remark.d.ts", "default": "./dist/remark.js" },
    "./components": { "types": "./dist/components.d.ts", "default": "./dist/components.js" },
    "./Code.astro": "./components/Code.astro",
    "./Playground.astro": "./components/Playground.astro",
    "./virtual": { "types": "./virtual.d.ts" }
  },
  "files": ["dist", "components", "virtual.d.ts", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && tsrs",
    "typecheck": "tsrs --noEmit",
    "prepack": "bun run build"
  },
  "peerDependencies": { "astro": "^7.0.0" },
  "dependencies": { "@pierre/highlights": "0.3.0" },
  "devDependencies": { "@types/mdast": "^4.0.4", "astro": "^7.4.5", "tsrs": "0.20.1-ts7.1.0-beta" },
  "publishConfig": { "access": "public" }
}
